{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exit-run",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "720051a3-ffbc-440d-800c-10d2c565dc20","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b7422e9549fb40bc8d0dbf346ea202c0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
